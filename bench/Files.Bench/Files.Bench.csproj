<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Files.Bench</AssemblyName>
    <RootNamespace>Files.Bench</RootNamespace>
    <!-- 基准测试需要真实代码路径，禁用优化会扭曲结果，因此 Release 下跑 -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Files.Core\Files.Core.csproj" />
    <ProjectReference Include="..\..\src\Files.Interop\Files.Interop.csproj" />
  </ItemGroup>

</Project>
