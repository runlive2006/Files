<Window x:Class="Files.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Files" Height="600" Width="960"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="上级目录" Click="OnGoUpClick" Padding="8,2" />
                <Button Content="刷新" Click="OnRefreshClick" Padding="8,2" />
                <Separator />
                <TextBlock x:Name="CurrentPathText"
                           VerticalAlignment="Center"
                           Margin="6,0"
                           FontWeight="SemiBold" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PerfText" Foreground="#666666" />
            </StatusBarItem>
        </StatusBar>

        <ListView x:Name="EntriesList" Margin="4"
                  MouseDoubleClick="OnEntryDoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="名称" Width="380" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="类型" Width="100" DisplayMemberBinding="{Binding Kind}" />
                    <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}" />
                    <GridViewColumn Header="修改时间" Width="180" DisplayMemberBinding="{Binding LastModifiedText}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
