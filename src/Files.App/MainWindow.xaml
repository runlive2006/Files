<Window x:Class="Files.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Files" Height="640" Width="1100"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="LayoutSingleButton" Content="单栏" Click="OnLayoutSingleClick"
                        ToolTip="单栏 (Ctrl+1)" Padding="8,2" />
                <Button x:Name="LayoutHorizontalButton" Content="左右" Click="OnLayoutHorizontalClick"
                        ToolTip="左右分栏 (Ctrl+2)" Padding="8,2" />
                <Button x:Name="LayoutVerticalButton" Content="上下" Click="OnLayoutVerticalClick"
                        ToolTip="上下分栏 (Ctrl+3)" Padding="8,2" />
                <Button x:Name="LayoutQuadButton" Content="四栏" Click="OnLayoutQuadClick"
                        ToolTip="田字四栏 (Ctrl+4)" Padding="8,2" />
                <Separator />
                <Button Content="新建文件夹" Click="OnNewFolderClick"
                        ToolTip="新建文件夹 (Ctrl+Shift+N)" Padding="8,2" />
                <Button Content="重命名" Click="OnRenameClick" ToolTip="重命名 (F2)" Padding="8,2" />
                <Button Content="删除" Click="OnDeleteClick" ToolTip="删除到回收站 (Del)" Padding="8,2" />
                <Separator />
                <TextBlock Text="视图" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="ViewModeBox" Width="100" VerticalAlignment="Center"
                          SelectionChanged="OnViewModeChanged">
                    <ComboBoxItem Content="详情" Tag="Details" IsSelected="True" />
                    <ComboBoxItem Content="列表" Tag="List" />
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="PaneIndicatorText" Text="栏 1/1" Foreground="#666666" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PerfText" Foreground="#666666" />
            </StatusBarItem>
        </StatusBar>

        <!-- 布局树在此动态渲染 -->
        <Grid x:Name="LayoutHost" />
    </DockPanel>
</Window>
