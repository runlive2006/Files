<Window x:Class="Files.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Files.App"
        mc:Ignorable="d"
        Title="Files" Height="600" Width="960"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- 列表（小图标）视图的项模板 -->
        <DataTemplate x:Key="ListTemplate">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <Border Width="16" Height="16" Margin="0,0,6,0"
                        Background="{Binding IconBrush}" CornerRadius="2" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SizeText}" Margin="12,0,0,0"
                           Foreground="#888888" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button x:Name="BackButton" Content="←" Click="OnBackClick"
                        ToolTip="后退 (Alt+←)" Padding="8,2" MinWidth="34" />
                <Button x:Name="ForwardButton" Content="→" Click="OnForwardClick"
                        ToolTip="前进 (Alt+→)" Padding="8,2" MinWidth="34" />
                <Button x:Name="UpButton" Content="↑" Click="OnGoUpClick"
                        ToolTip="上级目录 (Alt+↑)" Padding="8,2" MinWidth="34" />
                <Button Content="刷新" Click="OnRefreshClick" ToolTip="刷新 (F5)" Padding="8,2" />
                <Separator />
                <Button Content="新建文件夹" Click="OnNewFolderClick"
                        ToolTip="新建文件夹 (Ctrl+Shift+N)" Padding="8,2" />
                <Button Content="重命名" Click="OnRenameClick" ToolTip="重命名 (F2)" Padding="8,2" />
                <Button Content="删除" Click="OnDeleteClick" ToolTip="删除到回收站 (Del)" Padding="8,2" />
                <Separator />
                <TextBox x:Name="AddressBox" Width="420" Padding="4,2"
                         VerticalContentAlignment="Center"
                         KeyDown="OnAddressKeyDown"
                         GotKeyboardFocus="OnAddressGotFocus"
                         LostKeyboardFocus="OnAddressLostFocus"
                         ToolTip="输入路径后回车（支持 %USERPROFILE% 等环境变量）" />
                <Separator />
                <TextBlock Text="视图" VerticalAlignment="Center" Margin="4,0" />
                <ComboBox x:Name="ViewModeBox" Width="110" VerticalAlignment="Center"
                          SelectionChanged="OnViewModeChanged">
                    <ComboBoxItem Content="详情" Tag="Details" IsSelected="True" />
                    <ComboBoxItem Content="列表" Tag="List" />
                </ComboBox>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PerfText" Foreground="#666666" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <ListView x:Name="EntriesList" Margin="4"
                      SelectionMode="Extended"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      MouseDoubleClick="OnEntryDoubleClick"
                      PreviewKeyDown="OnListPreviewKeyDown">
                <ListView.ContextMenu>
                    <ContextMenu x:Name="EntryContextMenu" Opened="OnContextMenuOpened">
                        <MenuItem x:Name="MenuOpen" Header="打开" Click="OnOpenClick" />
                        <Separator />
                        <MenuItem Header="新建文件夹" Click="OnNewFolderClick" />
                        <MenuItem x:Name="MenuRename" Header="重命名" Click="OnRenameClick" InputGestureText="F2" />
                        <Separator />
                        <MenuItem x:Name="MenuCopy" Header="复制" Click="OnCopyClick" InputGestureText="Ctrl+C" />
                        <MenuItem x:Name="MenuCut" Header="剪切" Click="OnCutClick" InputGestureText="Ctrl+X" />
                        <MenuItem x:Name="MenuPaste" Header="粘贴" Click="OnPasteClick" InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem x:Name="MenuDelete" Header="删除" Click="OnDeleteClick" InputGestureText="Del" />
                        <MenuItem x:Name="MenuPermanentDelete" Header="永久删除"
                                  Click="OnPermanentDeleteClick" InputGestureText="Shift+Del" />
                        <Separator />
                        <MenuItem x:Name="MenuCopyPath" Header="复制路径" Click="OnCopyPathClick" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="360" local:ColumnSort.Key="Name">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" Margin="0,0,6,0"
                                                Background="{Binding IconBrush}" CornerRadius="2" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="110" DisplayMemberBinding="{Binding Kind}" local:ColumnSort.Key="Kind" />
                        <GridViewColumn Header="大小" Width="110" DisplayMemberBinding="{Binding SizeText}" local:ColumnSort.Key="Size" />
                        <GridViewColumn Header="修改时间" Width="170"
                                        DisplayMemberBinding="{Binding LastModifiedText}" local:ColumnSort.Key="LastModified" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </DockPanel>
</Window>
