<Window x:Class="Files.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:Files.App.Views"
        mc:Ignorable="d"
        Title="Files" Height="640" Width="1100"
        Icon="Assets/Files.ico"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- 工具栏：全部使用下拉菜单，避免并排按钮误点 -->
        <Menu DockPanel.Dock="Top" Background="#F7F7F7" Padding="2">
            <MenuItem Header="分栏方式" Padding="10,4">
                <MenuItem x:Name="MenuLayoutSingle" Header="单栏" IsCheckable="False"
                          Click="OnLayoutSingleClick" InputGestureText="Ctrl+1" />
                <MenuItem x:Name="MenuLayoutHorizontal" Header="左右" IsCheckable="False"
                          Click="OnLayoutHorizontalClick" InputGestureText="Ctrl+2" />
                <MenuItem x:Name="MenuLayoutVertical" Header="上下" IsCheckable="False"
                          Click="OnLayoutVerticalClick" InputGestureText="Ctrl+3" />
                <MenuItem x:Name="MenuLayoutQuad" Header="四栏" IsCheckable="False"
                          Click="OnLayoutQuadClick" InputGestureText="Ctrl+4" />
            </MenuItem>

            <MenuItem Header="操作" Padding="10,4">
                <MenuItem Header="复制" Click="OnCopyClick" InputGestureText="Ctrl+C" />
                <MenuItem Header="粘贴" Click="OnPasteClick" InputGestureText="Ctrl+V" />
                <MenuItem Header="剪切" Click="OnCutClick" InputGestureText="Ctrl+X" />
                <Separator />
                <MenuItem Header="新建文件夹" Click="OnNewFolderClick" InputGestureText="Ctrl+Shift+N" />
            </MenuItem>

            <MenuItem Header="视图" Padding="10,4">
                <MenuItem x:Name="MenuViewDetails" Header="详情" IsCheckable="True"
                          Click="OnViewDetailsClick" />
                <MenuItem x:Name="MenuViewList" Header="列表" IsCheckable="True"
                          Click="OnViewListClick" />
                <MenuItem x:Name="MenuViewThumbnails" Header="缩略图" IsCheckable="True"
                          Click="OnViewThumbnailsClick" />
                <Separator />
                <MenuItem x:Name="MenuShowNavigationPane" Header="导航窗格" IsCheckable="True"
                          IsChecked="True" Click="OnToggleNavigationPaneClick" InputGestureText="Ctrl+Shift+E" />
                <MenuItem x:Name="MenuShowDetailsPane" Header="详情窗格" IsCheckable="True"
                          IsChecked="False" Click="OnToggleDetailsPaneClick" InputGestureText="Alt+Shift+P" />
            </MenuItem>

            <MenuItem Header="设置" Padding="10,4">
                <MenuItem Header="打开设置…" Click="OnOpenSettingsClick" InputGestureText="Ctrl+," />
                <Separator />
                <MenuItem x:Name="MenuUseSystemIcons" Header="使用系统图标" IsCheckable="True"
                          IsChecked="True" Click="OnToggleSystemIconsClick" />
            </MenuItem>
        </Menu>

        <!-- 详情窗格（窗口级，显示焦点栏的选中项） -->
        <Border x:Name="DetailsPane" DockPanel.Dock="Bottom"
                Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,1,0,0"
                Padding="12,8" Height="88" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="48" Height="48" Margin="0,0,14,0"
                        VerticalAlignment="Center" Background="#F0F0F0" CornerRadius="4">
                    <Image x:Name="DetailsIcon" Stretch="Uniform" Margin="6"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="DetailsTitle" FontWeight="SemiBold" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsSubtitle" Foreground="#666666" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailsDetail" Foreground="#666666" Margin="0,3,0,0"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
        <StatusBar x:Name="StatusBar" DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="PaneIndicatorText" Text="栏 1/1" Foreground="#666666" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="就绪" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="PerfText" Foreground="#666666" />
            </StatusBarItem>
        </StatusBar>

        <!-- 导航窗格 + 布局树 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <views:NavigationPane x:Name="NavigationPanel" Grid.Column="0" Width="220" />

            <GridSplitter Grid.Column="1" Width="4"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns"
                          Background="#E8E8E8" />

            <!-- 布局树在此动态渲染 -->
            <Grid x:Name="LayoutHost" Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>
