<Window x:Class="Files.App.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入名称" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Text="名称" Margin="0,0,0,6" />
        <TextBox x:Name="ValueBox" Padding="4,3" />
        <TextBlock x:Name="ErrorText" Foreground="#C42B1C" Margin="0,6,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" IsDefault="True" Width="86" Padding="0,4"
                    Click="OnConfirmClick" />
            <Button Content="取消" IsCancel="True" Width="86" Padding="0,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
