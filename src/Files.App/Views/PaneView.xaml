<UserControl x:Class="Files.App.Views.PaneView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Files.App"
             mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="ListTemplate">
            <StackPanel Orientation="Horizontal" Margin="2,1">
                <Border Width="16" Height="16" Margin="0,0,6,0"
                        Background="{Binding IconBrush}" CornerRadius="2" />
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding SizeText}" Margin="12,0,0,0"
                           Foreground="#888888" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>

        <!-- 单个标签 -->
        <DataTemplate x:Key="TabTemplate">
            <Border x:Name="TabBorder" Padding="8,3" Margin="0,0,2,0"
                    Background="#F0F0F0" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                               MaxWidth="160" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentPath}" />
                    <Button Content="✕" Click="OnCloseTabClick" Margin="6,0,0,0"
                            Padding="0" Width="16" Height="16" FontSize="10"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="关闭标签 (Ctrl+W)" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabBorder" Property="Background" Value="White" />
                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="#0078D4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="FocusBorder" BorderThickness="2" BorderBrush="Transparent">
        <DockPanel>
            <!-- 栏头：本栏独立的导航 -->
            <Grid DockPanel.Dock="Top" Margin="2,2,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Grid.Column="0" Content="←" Click="OnBackClick"
                        ToolTip="后退 (Alt+←)" Padding="6,1" MinWidth="28" Margin="0,0,2,0" />
                <Button x:Name="ForwardButton" Grid.Column="1" Content="→" Click="OnForwardClick"
                        ToolTip="前进 (Alt+→)" Padding="6,1" MinWidth="28" Margin="0,0,2,0" />
                <Button x:Name="UpButton" Grid.Column="2" Content="↑" Click="OnUpClick"
                        ToolTip="上级目录 (Alt+↑)" Padding="6,1" MinWidth="28" Margin="0,0,4,0" />

                <TextBox x:Name="AddressBox" Grid.Column="3" Padding="4,2"
                         VerticalContentAlignment="Center"
                         KeyDown="OnAddressKeyDown"
                         GotKeyboardFocus="OnAddressGotFocus"
                         LostKeyboardFocus="OnAddressLostFocus"
                         ToolTip="输入路径后回车（支持 %USERPROFILE% 等环境变量）" />

                <Button x:Name="NewTabButton" Grid.Column="4" Content="＋" Click="OnNewTabClick"
                        ToolTip="新建标签 (Ctrl+T)" Padding="6,1" MinWidth="26" Margin="4,0,0,0" />
            </Grid>

            <!-- 标签条：仅在标签数 ≥2 时显示 -->
            <ItemsControl x:Name="TabStrip" DockPanel.Dock="Top" Margin="2,2,2,0"
                          ItemTemplate="{StaticResource TabTemplate}"
                          Visibility="Collapsed">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <ListView x:Name="EntriesList" Margin="2"
                      SelectionMode="Extended"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      MouseDoubleClick="OnEntryDoubleClick"
                      PreviewKeyDown="OnListPreviewKeyDown">
                <ListView.ContextMenu>
                    <ContextMenu x:Name="EntryContextMenu" Opened="OnContextMenuOpened">
                        <MenuItem x:Name="MenuOpen" Header="打开" Click="OnOpenClick" />
                        <Separator />
                        <MenuItem Header="新建文件夹" Click="OnNewFolderClick" />
                        <MenuItem x:Name="MenuRename" Header="重命名" Click="OnRenameClick" InputGestureText="F2" />
                        <Separator />
                        <MenuItem x:Name="MenuCopy" Header="复制" Click="OnCopyClick" InputGestureText="Ctrl+C" />
                        <MenuItem x:Name="MenuCut" Header="剪切" Click="OnCutClick" InputGestureText="Ctrl+X" />
                        <MenuItem x:Name="MenuPaste" Header="粘贴" Click="OnPasteClick" InputGestureText="Ctrl+V" />
                        <Separator />
                        <MenuItem x:Name="MenuDelete" Header="删除" Click="OnDeleteClick" InputGestureText="Del" />
                        <MenuItem x:Name="MenuPermanentDelete" Header="永久删除"
                                  Click="OnPermanentDeleteClick" InputGestureText="Shift+Del" />
                        <Separator />
                        <MenuItem x:Name="MenuCopyPath" Header="复制路径" Click="OnCopyPathClick" />
                    </ContextMenu>
                </ListView.ContextMenu>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="名称" Width="320" local:ColumnSort.Key="Name">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="16" Height="16" Margin="0,0,6,0"
                                                Background="{Binding IconBrush}" CornerRadius="2" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="类型" Width="90" DisplayMemberBinding="{Binding Kind}" local:ColumnSort.Key="Kind" />
                        <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding SizeText}" local:ColumnSort.Key="Size" />
                        <GridViewColumn Header="修改时间" Width="150"
                                        DisplayMemberBinding="{Binding LastModifiedText}" local:ColumnSort.Key="LastModified" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>
