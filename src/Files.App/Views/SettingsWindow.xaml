<Window x:Class="Files.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Files.App.ViewModels"
        mc:Ignorable="d"
        Title="设置" Height="560" Width="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Icon="/Assets/Files.ico">

    <Window.Resources>
        <!--
            单个设置项：左侧名称+说明，右侧控件。
            控件类型由 ViewModel 的 IsBoolean/IsInteger/IsEnum/IsText 决定，
            用 Visibility 切换而不是写 34 个模板。
        -->
        <DataTemplate x:Key="SettingItemTemplate">
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="{Binding Descriptor.DisplayName}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Descriptor.Description}"
                               Foreground="#777777" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding ShowDescriptionVisibility}" />
                    <TextBlock Text="{Binding ReadOnlyReason}"
                               Foreground="#B06000" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding ShowReadOnlyHintVisibility}" />
                </StackPanel>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <!-- 布尔 -->
                    <CheckBox IsChecked="{Binding BoolValue, Mode=TwoWay}"
                              IsEnabled="{Binding IsEditable}"
                              HorizontalAlignment="Right"
                              Visibility="{Binding BooleanVisibility}" />

                    <!-- 整数 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding IntegerVisibility}">
                        <Slider Value="{Binding IntValue, Mode=TwoWay}"
                                Minimum="{Binding Descriptor.Min}"
                                Maximum="{Binding Descriptor.Max}"
                                TickFrequency="{Binding Descriptor.Step}"
                                IsSnapToTickEnabled="True"
                                Width="140" VerticalAlignment="Center"
                                IsEnabled="{Binding IsEditable}" />
                        <TextBlock Text="{Binding IntValue}" Width="42"
                                   TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- 枚举 -->
                    <ComboBox ItemsSource="{Binding Descriptor.Options}"
                              DisplayMemberPath="Value"
                              SelectedValuePath="Key"
                              SelectedValue="{Binding Value, Mode=TwoWay}"
                              IsEnabled="{Binding IsEditable}"
                              HorizontalAlignment="Stretch"
                              Visibility="{Binding EnumVisibility}" />

                    <!-- 文本 / 目录 -->
                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             IsEnabled="{Binding IsEditable}"
                             VerticalContentAlignment="Center"
                             Padding="4,2"
                             Visibility="{Binding TextVisibility}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <DockPanel>
        <!-- 底部按钮 -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" Padding="12,10"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="恢复本组默认" Click="OnResetGroupClick" Padding="12,4" />
                    <Button Content="打开配置目录" Click="OnOpenConfigDirClick" Padding="12,4" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" IsCancel="True" Width="88" Padding="0,4" Click="OnCancelClick" />
                    <Button Content="确定" IsDefault="True" Width="88" Padding="0,4" Margin="8,0,0,0"
                            Click="OnConfirmClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 搜索 -->
        <Border DockPanel.Dock="Top" Padding="12,10">
            <TextBox x:Name="SearchBox" Padding="5,3"
                     Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                     ToolTip="按名称或说明搜索设置项" />
        </Border>

        <!-- 左侧分组 -->
        <ListBox DockPanel.Dock="Left" Width="150" Margin="12,0,0,12"
                 ItemsSource="{Binding Groups}"
                 SelectedItem="{Binding SelectedGroup, Mode=TwoWay}"
                 BorderBrush="#E0E0E0" />

        <!-- 右侧内容 -->
        <Grid Margin="12,0,12,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Items}"
                              ItemTemplate="{StaticResource SettingItemTemplate}" />
            </ScrollViewer>

            <TextBlock Text="没有匹配的设置项"
                       Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding EmptyVisibility}" />
        </Grid>
    </DockPanel>
</Window>
