<UserControl x:Class="Files.App.Views.BreadcrumbBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <!-- 面包屑模式：分段按钮 -->
        <Border x:Name="CrumbHost" Background="White" BorderBrush="#DDDDDD"
                BorderThickness="1" CornerRadius="2" Padding="1">
            <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" />
            </ScrollViewer>
        </Border>

        <!-- 编辑模式：纯文本框 -->
        <TextBox x:Name="EditBox" Padding="4,2" Visibility="Collapsed"
                 VerticalContentAlignment="Center"
                 KeyDown="OnEditKeyDown"
                 LostKeyboardFocus="OnEditLostFocus"
                 ToolTip="输入路径后回车（支持 %USERPROFILE% 等环境变量）" />
    </Grid>
</UserControl>
