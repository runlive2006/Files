<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- 将全局包缓存固定在仓库本地目录，避免污染用户目录并让构建可复现 -->
    <add key="globalPackagesFolder" value=".dotnet/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
